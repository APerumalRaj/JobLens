# ================================
# JobLens Environment Configuration
# ================================
# Copy this file to .env and fill in your values
# DO NOT COMMIT THIS FILE TO GIT!
# ================================

# ============================================
# Gmail OAuth2 Configuration
# Get these values from Google Cloud Console
# See GMAIL_SETUP_GUIDE.md for detailed steps
# ============================================

# Your OAuth2 Client ID from Google Cloud Console
# Format: xxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Your OAuth2 Client Secret from Google Cloud Console
# Format: GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Your Gmail email address
# This account should have 2FA enabled
GMAIL_USER_EMAIL=your.email@gmail.com

# ============================================
# Gmail SMTP Configuration
# Generate this from Google Account Settings
# See GMAIL_SETUP_GUIDE.md for detailed steps
# ============================================

# App Password from Google Account
# Generate at: https://myaccount.google.com/apppasswords
# Format: 16 characters, usually in 4 groups of 4
# REMOVE SPACES if provided with spaces!
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ============================================
# Email Recipient Configuration
# ============================================

# Email address where job summaries should be sent
RECIPIENT_EMAIL=your.recipient@gmail.com

# ============================================
# Optional: Job Filtering Configuration
# ============================================

# Minimum years of experience you want
# Default: 1
JOB_MIN_EXPERIENCE=1

# Maximum years of experience you want
# Default: 3
JOB_MAX_EXPERIENCE=3

# Maximum number of job results to include in email
# Default: 10
JOB_MAX_RESULTS=10

# ============================================
# Optional: Spring Boot Configuration
# ============================================

# Logging level
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_JOBLENS=DEBUG

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Never commit this file to version control
# 2. Add .env to .gitignore
# 3. Regenerate app passwords if exposed
# 4. Keep backups of your OAuth credentials
# 5. Review security settings regularly

# ============================================
# Example Values (for reference)
# ============================================
# GMAIL_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-AbCdEfGhIjKlMnOpQrStUvWxYz
# GMAIL_USER_EMAIL=jobseeker@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# RECIPIENT_EMAIL=notifications@gmail.com
